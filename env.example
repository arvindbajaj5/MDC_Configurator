# Google Cloud Console OAuth + Picker API configuration
# In GitHub repo Settings -> Secrets and variables -> Actions -> Variables,
# add these three public browser variables so GitHub Pages builds include them.
VITE_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_PICKER_API_KEY=your-http-referrer-restricted-api-key
VITE_GOOGLE_APP_ID=your-gcp-project-number
